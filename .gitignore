# === Secrets and signing material — never commit ===
.env
.env.*
!.env.example
*.pem
*.key
*.p8
*.p12
*.jks
*.keystore
*.mobileprovision
*-service-account.json
google-services.json
GoogleService-Info.plist
android/key.properties

# === OS ===
.DS_Store
Thumbs.db

# === IDE ===
.idea/
.vscode/
*.iml
*.swp

# === Go ===
bin/
dist/
*.exe
*.test
*.out
coverage.*

# A bare `go build ./cmd/<name>` run from services/core drops the binary beside the
# module, rather than into bin/ where `make build` and every mk/ target put it. One
# line per cmd package instead of a glob: a glob here would also swallow a directory
# somebody meant to commit, and `api` is exactly the name that would be.
/services/core/api
/services/core/lintboundaries
/services/core/migrate
/services/core/notifier
/services/core/statusgen
/services/core/topics
/services/core/worker

# === Flutter / Dart ===
apps/mobile/.dart_tool/
apps/mobile/.flutter-plugins
apps/mobile/.flutter-plugins-dependencies
apps/mobile/build/
apps/mobile/ios/Pods/
apps/mobile/ios/.symlinks/
apps/mobile/ios/Flutter/Flutter.framework
apps/mobile/ios/Flutter/Generated.xcconfig
apps/mobile/android/.gradle/
apps/mobile/android/local.properties
apps/mobile/android/app/debug/
apps/mobile/android/app/release/

# === Node / Next.js ===
node_modules/
.next/
out/
.turbo/
*.tsbuildinfo
# Regenerated by `next build` and `next dev`, and it names the Next version that wrote it,
# so committing it produces a diff on every upgrade and a conflict on every branch.
next-env.d.ts

# === Local infrastructure ===
deploy/data/
deploy/**/pgdata/
